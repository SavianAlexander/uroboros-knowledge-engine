# ==============================================================================
# Uroboros Knowledge Engine: Environment Variables Configuration Template
# Copy to '.env' for local configuration overrides
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
MAX_WORKERS=2

# Storage & Database File Paths
ACTIVE_DIR=dumps
DB_FILE=/app/data/knowledge.db
VAULT_DIR=/app/vault
BACKUP_DIR=/app/backups
BACKUP_INTERVAL=3600

# Local AI & Ollama Integration
LLM_API_KEY=ollama
OPENAI_API_BASE=http://host.docker.internal:11434/v1
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen2.5:7b
DEFAULT_CHAT_MODEL=qwen2.5:7b

# Security & Authentication (JWT)
JWT_SECRET=uroboros-incomparable-secret-token-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENABLED=false

# Hardware & Optimization
HSA_OVERRIDE_GFX_VERSION=10.3.0
CUDA_VISIBLE_DEVICES=0
